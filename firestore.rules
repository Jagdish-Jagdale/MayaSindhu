rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helper Functions
     */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the user has an admin role.
    function isAdmin() {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin', 'superadmin', 'Super Admin']);
    }

    /**
     * Collection Rules
     */

    // 1. Home Page & Public Content (Read: Anyone, Write: Admin)
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /curatedRealms/{id} { allow read: if true; allow write: if isAdmin(); }
    match /shopByTrend/{id} { allow read: if true; allow write: if isAdmin(); }
    match /shopTheLook/{id} { allow read: if true; allow write: if isAdmin(); }
    match /ourPurpose/{id} { allow read: if true; allow write: if isAdmin(); }
    match /featuredTreasures/{id} { allow read: if true; allow write: if isAdmin(); }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /aboutus/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // 2. User Data (Read/Write: Owner or Admin)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
      
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 3. Orders (Secured by customerUid)
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Notifications (Read: Admin, Create: System/Any)
    match /notifications/{notifId} {
      allow create: if true; 
      allow read, delete: if isAdmin();
      allow update: if false; 
    }

    // 5. Admin Management
    match /admins/{adminId} {
      // Allow signed-in users to read the admins list to verify their own status
      allow read: if isSignedIn();
      allow write: if isAdmin(); 
    }
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if isSignedIn() && isAdmin();
      allow read, write: if false;
    }
  }
}
